# PostgreSQL connection string template for the database that stores application records.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/smart_food_waste
# MongoDB connection URI template for the activity log.
MONGODB_URI=mongodb://127.0.0.1:27017/smart_food_waste
# Name of the MongoDB database used by the event logger.
MONGODB_DB=smart_food_waste
# Placeholder for the server secret that signs and verifies login tokens.
SESSION_SECRET=change-this-to-a-long-random-secret
